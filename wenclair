#header {
  background-image: url("https://raw.githubusercontent.com/celedriel/wenclair-ao3-skin/refs/heads/main/wenclair.jpg");
  background-repeat: no-repeat;
  background-position: center 30%;
  background-size: cover;
  display: flex !important;
  flex-direction: column !important;
}

#header .heading {
  min-height: 230px !important;
  width: 100% !important;
  margin: 0 !important;
  padding: 10px !important;
  box-sizing: border-box !important;
}

#header .logo {
  content: url("https://raw.githubusercontent.com/celedriel/wenclair-ao3-skin/refs/heads/main/ao3-logo-purple.png");
}

#header .heading sup {
  visibility: hidden;
}

#greeting {
  width: 100% !important;
  background: #000000 !important;
  margin: 0 !important;
  padding: 5px 15px !important;
  box-sizing: border-box !important;
  display: flex !important;
  justify-content: flex-end !important;
  align-items: center !important;
  box-shadow: none !important;
  border: none !important;
}

#header .primary {
  width: 100% !important;
  background: #000000 !important;
  margin: 0 !important;
  box-sizing: border-box !important;
  box-shadow: none !important;
  border: none !important;
}

.icon img,
#greeting .icon img,
img.icon {
  border-radius: 50% !important;
  border: 1.5px solid #CBA6F6 !important;
}

#outer.wrapper {
  background: #000000;
  color: #E0DEF4;
  overflow-x: hidden;
}

#inner.wrapper {
  margin: 0 auto !important;
  padding: 0 4% !important;
}

.userstuff {
  line-height: 1.6 !important;
}

#main,
#inner.wrapper,
.listbox .index,
.work.own,
.thread .even {
  background: #000000;
  color: #E0DEF4;
}

#main .heading,
#main .heading a,
.work .heading a {
  color: #CBA6F6 !important;
}

a[rel="author"],
.byline a {
  color: #F4A6D7 !important;
}

.work.blurb,
li.blurb,
.work .wrapper,
#main .wrapper,
.bookmark .user {
  border: none !important;
  background-color: #000000 !important;
  padding: 15px 10px;
  border-radius: 10px;
  margin-bottom: 15px;
  box-shadow: none !important;
}

a,
a.tag,
#main a,
#greeting a.dropdown-toggle {
  color: #E0DEF4;
  text-decoration: none;
}

a:hover,
a:focus,
#main a:hover {
  color: #F4A6D7;
  text-decoration: none;
  background: transparent;
}

h1.heading a {
  color: #CBA6F6 !important;
  font-weight: 515;
}

#greeting .menu,
#header .dropdown .menu,
#header .dropdown:hover a,
.dropdown,
.ui-sortable li,
.dynamic form,
div.dynamic {
  background: #000000;
  border: 1px solid #1a1a1a;
  color: #E0DEF4;
}

#header .menu a,
#header .dropdown .menu a,
#greeting .menu a,
#header .dropdown .menu li {
  border-color: #1a1a1a !important;
  border-bottom-color: #1a1a1a !important;
}

#dashboard.own {
  border-top: 2px solid #1a1a1a;
  border-bottom: 2px solid #1a1a1a;
}

#dashboard a {
  color: #E0DEF4;
}

#dashboard a:hover,
.current,
#dashboard .current {
  background: #1a1a1a !important;
  color: #F4A6D7 !important;
  border-radius: 5px;
}

button,
.actions a,
.actions a:link,
.action,
input[type="submit"],
.actions a:visited,
.filtering .filters #leave_filters {
  color: #000000;
  background-color: #CBA6F6;
  border: none;
  border-radius: 5px;
  box-shadow: none;
}

button:hover,
.actions a:hover,
.action:hover,
input[type="submit"]:hover {
  color: #000000;
  background-color: #F4A6D7;
}

li.warnings a,
li.relationships a {
  display: inline-block;
  padding: 1.5px 5px;
  margin: 2.5px 1px;
  border-radius: 4px;
  color: #E0DEF4 !important;
  text-decoration: none;
  border: none;
}

li.warnings a {
  background-color: #B30000 !important;
  color: #FFFFFF !important;
}

li.relationships a {
  background-color: #571845 !important;
}

li.warnings a:hover,
li.relationships a:hover {
  background-color: transparent !important;
  border: none !important;
  color: #F4A6D7 !important;
}

.notice:not(.required),
.comment_notice,
.kudos_notice,
ul.notes,
.comment_error,
.kudos_error,
.alert.flash,
.comment,
form dl,
fieldset,
input,
select,
textarea,
span.symbol.question,
.own,
form.search input[type=text],
form.search input[type=submit],
.autocomplete div.dropdown ul {
  background: #000000 !important;
  color: #E0DEF4 !important;
  border: none !important;
  box-shadow: none !important;
}

.caution {
  background: #F4A936 !important;
  color: #000000 !important;
}

.error {
  background: #E26586 !important;
  color: #E0DEF4 !important;
}

#footer {
  background: #000000;
  color: #E0DEF4;
  border-top: none !important;
}

#footer a,
#footer .heading {
  color: #CBA6F6;
}

::-webkit-scrollbar {
  height: 10px;
  width: 10px;
  background: #000000;
}

::-webkit-scrollbar-thumb {
  background: #633F88;
  border-radius: 5px;
}

::-webkit-scrollbar-thumb:hover {
  background: #CBA6F6;
}

span.submit.actions input.button {
  display: none;
}

